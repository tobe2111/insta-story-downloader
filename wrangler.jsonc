{
  "name": "quant",
  "main": "worker.js",
  "compatibility_date": "2026-07-05",
  // 고객 등록 전략 수집함(선택) — Cloudflare 대시보드 → Storage & Databases →
  // KV에서 네임스페이스를 만들고 아래 주석을 풀어 id를 채우면 /api/submit-spec
  // 저장과 어드민 목록이 켜진다. 미설정이어도 사이트·수집 외 기능은 정상이며,
  // 제출자는 "수집함 미설정" 안내를 받는다(조용히 버려지지 않는다).
  // "kv_namespaces": [{ "binding": "SUBMISSIONS", "id": "<네임스페이스 ID>" }],
  "assets": {
    "directory": "./docs",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  }
}
