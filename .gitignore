# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/
env/

# 설정/비밀 (절대 커밋 금지)
config.yaml
config/config.yaml
.env
*.key
secrets/
# 판매자 라이선스 비밀(배포 빌드에만 포함, 절대 커밋 금지)
quant/_license_key.py
# Ed25519 개인키 — 판매자만 보관, 절대 커밋·배포 금지(유출 시 키 발급 가능)
quant/_license_priv*
*.pem
# 공개키 모듈은 배포본 빌드 시 생성한다(공개돼도 안전하지만 저장소엔 안 둔다)
quant/_license_pub.py

# 데이터/결과물
data_cache/
*.csv
*.parquet
results/
*.png
# SNS 게시 이미지는 커밋해야 한다 — Meta API가 공개 URL로 받아가는 재료
!docs/social/**/*.png
!docs/card.png

# OS/IDE
.DS_Store
.idea/
.vscode/

# Claude Code 에이전트 임시 워크트리 (커밋 금지)
.claude/

# wrangler (Cloudflare)
.wrangler
.dev.vars*

# 커버리지 산출물 — 측정할 때마다 바뀌는 바이너리라 추적하지 않는다.
# (2026-08-11: 감사 중 커버리지를 재면서 실수로 커밋했다. 77KB SQLite가
#  매 측정마다 diff에 잡히면 진짜 변경이 묻힌다.)
.coverage
.coverage.*
htmlcov/

# 사용자가 넣은 전략 명세 — 각자의 것이라 저장소에 안 올린다.
# (state/specs_user/ 아래 것은 계좌 장부와 함께 공개된다 — 실제 링에 선
#  전략은 숨기지 않는다는 뜻이다.)
/specs_user/

# 알림 대기열(감사 283) — 커밋 전에 쌓아 두는 임시 파일.
# 장부에 섞이면 '저장된 것만 방송한다'는 규칙 자체가 헷갈린다.
state/.notice_queue.jsonl

# 변이 전수가 남기는 결과물 — 저장소에 커밋할 것이 아니다(감사 301).
mutation.txt
mutation_summary.txt
